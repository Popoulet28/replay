{
  "name": "replay",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Replay : cours au stylet, carnet d'erreurs et leçons de physique (Android + Windows)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "lint": "eslint --ext .js,.mjs web/src tests scripts",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "esbuild": "0.21.5",
    "eslint": "8.57.1",
    "fake-indexeddb": "6.0.0",
    "vitest": "1.6.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource/kalam": "^5.1.0",
    "katex": "^0.16.11"
  }
}
